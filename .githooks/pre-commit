#!/usr/bin/env bash
# PHI guard: refuse to commit raw PHI artifacts. Runs on every `git commit`,
# independently of Claude. Versioned in .githooks/ and wired via
# `git config core.hooksPath .githooks` (see setup_hooks.sh).
set -euo pipefail

# Staged files (added/copied/modified), NUL-separated for safe filenames.
mapfile -d '' staged < <(git diff --cached --name-only -z --diff-filter=ACM)

phi_regex='\.(dcm|dicom|tar|png|jpg|jpeg|tif|tiff|bmp|gif|webp|npy|npz)$'
# Phase 10c / D-10c.8: `ground_truth/seed/` holds the per-image Tesseract seed JSONs, which
# contain read-back PHI token text. Trailing slash is REQUIRED so the PHI-free sibling
# `ground_truth/seed_summary.json` is NOT matched. Add-only; no existing branch changed.
# `.*\.part`: an interrupted atomic write. build_gt.write_gt() stages the full gt.csv table
# at `ground_truth/gt.csv.part` before validating it, and 10d stages review records the same
# way; a crash leaves the file on disk holding PHI. `gt\.csv$` does not match it (`.part` is
# the final extension), so this branch is required, not redundant. No .part file is ever a
# legitimate commit.
# `ground_truth/seed(_*)/` and `ground_truth/review*/` hold the per-image Tesseract seeds and
# the human-confirmed review records — the same token text as gt.csv. They are gitignored, so
# the ONLY way one reaches staging is `git add -f`, which is exactly the bypass this hook
# exists to catch. `[^/]*` cannot cross a separator, so the PHI-FREE sibling
# `ground_truth/seed_summary.json` is still not matched. Mirrors block_phi_read.py's PHI_NAME.
name_regex='(^|/)(gt\.csv|.*raw_response.*|manifest\.csv|ground_truth/seed(_[^/]*)?/.*|ground_truth/review.*/.*|.*\.part)$'

blocked=()
for f in "${staged[@]:-}"; do
  [ -z "$f" ] && continue
  if [[ "$f" =~ $phi_regex ]] || [[ "$f" =~ $name_regex ]]; then
    blocked+=("$f")
  fi
done

if [ "${#blocked[@]}" -gt 0 ]; then
  echo "✗ COMMIT BLOCKED — these look like PHI and must never be committed:" >&2
  printf '    %s\n' "${blocked[@]}" >&2
  echo "" >&2
  echo "  PHI (DICOM/images/gt.csv/raw_response/manifest) stays out of git." >&2
  echo "  If a file is a false positive, fix .gitignore or rename it; do NOT" >&2
  echo "  bypass with --no-verify on this repo." >&2
  exit 1
fi
exit 0
